# This repository records the maintained Stage6 project and its key design records.
# Historical experiments and original evidence remain in the local workspace.
/*
!/.gitignore
!/README.md
!/版本管理说明.md
!/本地资料索引.md
!/ccs_stage6_workspace/
!/软件验证/
!/连接设计/

/ccs_stage6_workspace/*
!/ccs_stage6_workspace/Stage6_SENSORED_FOC/

# CCS output and local IDE state are regenerated by CCS.
/ccs_stage6_workspace/Stage6_SENSORED_FOC/CPU1_SENSORED_FOC_RAM/
/ccs_stage6_workspace/Stage6_SENSORED_FOC/.settings/
/ccs_stage6_workspace/Stage6_SENSORED_FOC/.theia/
/ccs_stage6_workspace/Stage6_SENSORED_FOC/src_device/driverlib/ccs/Debug/
/ccs_stage6_workspace/Stage6_SENSORED_FOC/src_device/driverlib/ccs/Release/
/ccs_stage6_workspace/Stage6_SENSORED_FOC/libraries/observers/est_lib/*.lib
**/.metadata/
**/.clangd/
**/__pycache__/
**/*.pyc

/软件验证/*
!/软件验证/2026-11-17_Stage6_R03系统集成/
/软件验证/2026-11-17_Stage6_R03系统集成/*
!/软件验证/2026-11-17_Stage6_R03系统集成/*.md
!/软件验证/2026-11-17_Stage6_R03系统集成/*.py
!/软件验证/2026-11-17_Stage6_R03系统集成/host/
!/软件验证/2026-11-17_Stage6_R03系统集成/profile/
!/软件验证/2026-11-17_Stage6_R03系统集成/src/
!/软件验证/2026-11-17_Stage6_R03系统集成/tools/

/连接设计/*
!/连接设计/*.md
